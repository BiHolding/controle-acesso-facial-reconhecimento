# ── MySQL ──────────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ispevolution_p
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password

# ── API VIP e dispositivo ────────────────────────────────────────────────────
API_URL=https://ispevolution.com.br/vip/api/v1
ACCESS_POINT=ENTRADA_PRINCIPAL
DEVICE_KEY=replace-with-single-station-key
ENROLLMENT_DEVICE_KEY=replace-with-enrollment-key
CAMERA_INDEX=0
DISPLAY_INDEX=0
# ID do dispositivo na tabela access_control_devices (0 = não registra eventos)
DEVICE_ID=0

# ── Operação dupla (um notebook, dois monitores e duas webcams) ───────────────
STATION_1_CAMERA_INDEX=0
STATION_1_DISPLAY_INDEX=0
STATION_1_DEVICE_ID=0
STATION_1_DIRECTION=ENTRY
STATION_1_ACCESS_POINT=ENTRADA_PRINCIPAL
STATION_1_DEVICE_KEY=replace-with-entry-device-key
STATION_2_CAMERA_INDEX=1
STATION_2_DISPLAY_INDEX=1
STATION_2_DEVICE_ID=0
STATION_2_DIRECTION=EXIT
STATION_2_ACCESS_POINT=SAIDA_PRINCIPAL
STATION_2_DEVICE_KEY=replace-with-exit-device-key

# ── Reconhecimento facial ─────────────────────────────────────────────────────
FACE_MODEL_VERSION=v1

# ── Enrollment via FTP ────────────────────────────────────────────────────────
# Habilita enrollment automático de Guests sem embedding
FACE_ENROLLMENT_ENABLED=true
# Intervalo entre tentativas de enrollment (segundos)
FACE_ENROLLMENT_INTERVAL_SECONDS=30

# Configuração FTP para download de fotos
FTP_HOST=replace-with-ftp-host
FTP_PORT=21
FTP_USER=replace-with-ftp-user
FTP_PASSWORD=replace-with-ftp-password
# Caminho base no FTP onde as fotos estão armazenadas
FTP_BASE_PATH=vip-backend/writable/guests

# ── Debug ─────────────────────────────────────────────────────────────────────
FACE_DEBUG=false
