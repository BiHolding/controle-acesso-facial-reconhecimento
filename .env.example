# ── MySQL ──────────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ispevolution_p
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password

# ── Dispositivo ───────────────────────────────────────────────────────────────
ACCESS_POINT=vip_room
CAMERA_INDEX=0
DISPLAY_INDEX=0
# ID do dispositivo na tabela access_control_devices (0 = não registra eventos)
DEVICE_ID=0

# ── Reconhecimento facial ─────────────────────────────────────────────────────
FACE_MATCH_THRESHOLD=0.60
FACE_MODEL_VERSION=v1
FACE_SYNC_INTERVAL_SECONDS=30

# ── Enrollment via FTP ────────────────────────────────────────────────────────
# Habilita enrollment automático de Guests sem embedding
FACE_ENROLLMENT_ENABLED=true
# Intervalo entre tentativas de enrollment (segundos)
FACE_ENROLLMENT_INTERVAL_SECONDS=30

# Configuração FTP para download de fotos
FTP_HOST=replace-with-ftp-host
FTP_PORT=21
FTP_USER=replace-with-ftp-user
FTP_PASSWORD=replace-with-ftp-password
# Caminho base no FTP onde as fotos estão armazenadas
FTP_BASE_PATH=vip-backend/writable/guests

# ── Debug ─────────────────────────────────────────────────────────────────────
FACE_DEBUG=false
